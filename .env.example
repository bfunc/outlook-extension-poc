# Copy to .env and fill in. .env is git-ignored.

# Public HTTPS folder the built add-in (dist/) is served from, no trailing slash.
ADDIN_BASE_URL=https://addin.example.com/outlook-addin
# Test endpoint (server/), used by the task pane and the send handler.
VITE_API_BASE=https://addin.example.com/api/outlook-poc
# A GUID of your own: e.g. `node -e "console.log(crypto.randomUUID())"`.
ADDIN_ID=00000000-0000-4000-8000-000000000000
ADDIN_PROVIDER=Your name
ADDIN_SUPPORT_URL=https://example.com/
